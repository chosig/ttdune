#class chryson kill;
#class chryson open;

#nop Burned fuse?;
#nop CPU Info - You rush coolant to your implants.;
#nop CPU Info - A fuse blows saving an implant from damage!;

#nop IMG SYSTEM MESSAGE: Sudo has achieved radvanced machine level 79.;

#nop INIT VARIABLES -----------------------------------------------------------
#var guild {
    {atombeam} {1}
    {matlimit} {50}
    {transfer} {1}
}

#var enemy {
    {name} {None}
    {hp} {0}
    {race} {}
    {count} {0}
    {weakness} {}
};

#nop EVENTS -------------------------------------------------------------------
/event.register GMCP.Char.Guild.Stats chryson _updateGuildStats;
#alias _updateGuildStats {
    #nop %0;
    #cat guild {%0};
    #var guild[TrueLevel] {@math{$guild[AMLevel]*400 + $guild[GuildLevel]}};
}
/event.register combatStart chryson _combat_start;
#alias {_combat_start} {
    #nop %0;
    #gag {^HP:};
    #gag {^$};
    #delay {_combat_start} {
        #send {auto fire, missile, pound, cut, shock @math{$guild[TrueLevel]*10}}
    } {1};
}
/event.register combatEnd chryson _combat_end;
#alias {_combat_end} {
    #nop %0;
    #ungag {^HP:};
    #ungag {^$};
}
/event.register GMCP.Char.Vitals chryson /heal;
#alias {/heal} {
    #nop %0;
    #if {$guild[transfer] == 1 && $char[hppct] < 90} {
        /send transfer;
        #var guild[transfer] 0;
    };
}
#action {^%w leaves %w} {/pursue %1 %2};
#alias /pursue {
    #nop %0;
    #if {"%1" == "$enemy[name]"} {
        /send %2;
    }
}

#nop ACTIONS ------------------------------------------------------------------
#action {^HP:%d/%d CP:%d/%d $:%d B:%d\%} {
    #var char[burden] %6;
}

#action {^[  HP: %d/%d  CP: %d/%d  Power: %d  Target: %d\%  SA: %w  ]} {
    /event.raise prompt.combat;

    #var enemy[hp] {%6};

    #nop Does this damage too? Fire it when we can.;
    #if {$guild[atombeam] && $char[hppct] < 95} {#send {atombeam}};

    #if {$char[cppct] > 25} {#send {devastate}};
    #send {headbutt};
    /status_draw;
}

#action {^[IDISP] %*} {
    #switch {"%1"} {
        #case {"You are awarded [ %d ] GEXP for your kill."} {/got_kill};

        #case {"Atomic scanners reset."} {
            #var guild[atombeam] 1;
            #line gag;
        };
        #case {"Atomic extractor recharging."} {
            #var guild[atombeam] 0;
            #line gag;
        };

        #case {"Transfer power back online."} {
            #var guild[transfer] 1;
            #line gag
        };
        #case {"Transference banks are still recharging."} {
            #var guild[transfer] 0;
            #line gag;
        };
        #case {"Complete power transfer successful."} {#line gag};

        #case {"%1 implant %2."} {/setimplant %0};

        #case {"Autonomous Combat Protocols now set to: fire,missile,pound,cut,shock %d."} {#line gag};
        #case {"Executing enhanced reflex fast-attack routine."} {#line gag};
        #case {"Emitter is active."} {#line gag};
        #case {"Unable to fire.  Ultra-shotgun is reloading."} {#line gag};
        #case {"Launch bay is currently reloading."} {#line gag};
        #case {"Arm servos already activated."} {#line gag};
        #case {"Cutters already in use."} {#line gag};

        #nop #default {#line gag};
    }
} {8}

#action {^There is nothing here you can kill.} {
    #var char[killauto] 0;
    #var char[killroom] 0;
    /loot;
}

#nop Atombeam, healing attack
#action {^%w shudders slightly as you drain %w energy into your exoskeleton.} {
    #var guild[atombeam] 0;
}

#nop ALIASES ------------------------------------------------------------------
#alias {/setimplant} {
    #local implant_list {
        {Muscle Replacement} {musrep}
        {Enhanced Reflexes} {ereflex}
        {Solar Panels} {solar}
        {Autorepair} {autorep}
        {Thermographic Optics} {thermo}
        {Nano Factory} {factory}
        {Laser Guidance} {guidance}
        {Auxiliary Batteries} {batteries}
        {ICTS Controller} {icontrol}
        {Temporal Drive} {tdrive}
        {Polymathematics Chip} {pmchip}
        {Autonomous Combat Processors} {auto}
    };

    #local implant {};
    #local status {};
    #regex %0 {(.*) implant (.*)\.} {
        #var implant $implant_list[&1];
        #switch {"&2"} {
            #case {"re-activated"} {#var status 1};
            #case {"deactivated"} {#var status 0};
        };
    };
    #var $guild[$implant] $status;
    #showme {GUILD: $implant is set to "$status"};
}
#alias {/got_kill} {
    #if {$char[killauto] == 1} {/send fkill};

    #if {"$enemy[race]" == "ixian"} {/salvage} {absorb};    
    #math enemy[count] {$enemy[count] - 1};
    #if {$enemy[count] <= 0} {#
        #var enemy[count] 0;
        #var char[killroom] 0;
    };
    #delay {lootDelay} {/loot} {1};

    #var enemy[name] {None};
    #var enemy[hp] {0};
    #var enemy[race] {};
}

#alias {/fkill} {
    #var enemy[count] 0;
    #var char[killauto] 1;
    fkill;
}

#alias {/rkill} {
    #var enemy[count] 0;
    #var char[killroom] 1;
    kill all;
}

#alias {/loot} {    
    #send {get all};
    #send {store all sockets};
    #if {$GMCP[Char][Guild][Stats][Material] < $guild[matlimit]} {
        #send {drop all};
        #send {convert all};
    } {
        #send {rsell all};
    };
}

#alias {/salvage} {
    #send {salvage corpse};
    #send {convert slag};
    #send {drop all salvage};
    #send {get all socket};
    #if {$guild[Material] < 90} {
        #send {convert all};
        #send {packstuff all salvage};
    } {
        #send {packstuff all salvage};
    };
    #if {$cube[active] == 0} {
        #send {count salvage}
    };
}

#alias {/levelup} {
    #local cmd {radvance level;radvance str;radvance con;radvance dex;radvance qui;radvance wis;radvance int};
    #local i {};
    #foreach {$cmd} {i} {#send {$i}};
}

#nop GAGS ---------------------------------------------------------------------
#gag {^Your exoskeleton completely absorbs the attack!$};

#class chryson close;