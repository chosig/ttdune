#class {event/combat} kill;
#class {events/combat} open;

#action {^You attack %w%!{\.?}$} {
    #var enemy[name] %1;
    #if {"$enemy[count]" == ""} {
        #var enemy[count] 1
    } {
        #var enemy[count] {@math{$enemy[count] + 1}};
    };
    #if {!$char[killroom]} {
        #delay {combatEvaluate} {/send evaluate @lower{%1}} {1};
    };
    /event.raise combatStart {$enemy[name]};
}

#action {^You are fighting %w} {
    #if {"%1" != "$enemy[name]"} {
        #delay {1} {#send {evaluate @lower{%1}}};
        #var enemy[name] %1;
        /event.raise combatStart {%1};
    }
}

#action {^You turn to attack %w} {
    #var enemy[name] %1;
    #if {!$char[killroom]} {
        #delay {1} {/send evaluate @lower{%1}};
    };
    /event.raise combatStart {%1};
}

#action {^You gain %1 for your kill.} {
    /event.raise combatEnd $enemy[race];
    #var enemy {
        {name} {None}
        {hp} {0}
        {race} {}
        {weakness} {}
    };
}

#nop Hunt;
#action {^%w leaves %w} {
    /event.raise _left_room %1 %2;
}

#var {bodyparts} {
    {body} {body}
    {head} {head}
    {chest} {chest}
    {stomach} {stomach}
    {right arm} {r_arm}
    {left arm} {l_arm}
    {right hand} {r_hand}
    {left hand} {l_hand}
    {right leg} {r_leg}
    {left leg} {l_leg}
    {right foot} {r_foot}
    {left foot} {l_foot}
}

#nop Worker Drone appears to have weak armour on its right hand.;
#action {^%!* appears to have weak armour on %!w %*.} {
    #var enemy[weakness] {$bodyparts[%1]};
    /send aim $bodyparts[%1];
}

#nop 150 levels of evaluate opponent seems to be needed to see race
#action {^%!w belongs to the %w race.} {
    #var enemy[race] %1;
    /event.raise combat_enemy_race {$enemy[race]};
}

#class {events/combat} close;