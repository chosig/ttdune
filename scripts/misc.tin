#class misc kill;
#class misc open;

#nop Space;
#action {Your %!w ship has arrived. Please enter your ship.} {enter ship};

#nop Password to Terro's
#action {^You find a small note in the drawer with the word %w written on it.} {
    #var terro {%1}
}
#alias terro {
    #parse {$terro} {i} {type $i};
    submit
}

#class misc close;